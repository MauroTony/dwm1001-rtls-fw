mainmenu "RTLS - Gateway"

menu "Gateway"

config RTLS_NODE_ID
	hex "Endereço curto do gateway"
	default 0x0001
	range 0x0001 0x0FFF
	help
	  As tags enviam POSITION para RTLS_ADDR_GATEWAY (0x0001); mude
	  apenas junto com rtls/frames.h.

config RTLS_GATEWAY_MAX_TAGS
	int "Capacidade da tabela de tags"
	default 16
	range 1 64

config RTLS_GATEWAY_TAG_TIMEOUT_MS
	int "Expiração de uma tag sem atualização (ms)"
	default 2000

config RTLS_GATEWAY_PUBLISH_MS
	int "Período de publicação do snapshot para o host (ms)"
	default 100

config RTLS_GATEWAY_CSV_OUTPUT
	bool "Imprime cada POSITION recebido em CSV na UART"
	default y
	help
	  Uma linha por POSITION: P,<tag>,<round>,<t_ms>,<x_mm>,<y_mm>,<z_mm>,
	  <sx_mm>,<sy_mm>,<sz_mm>,<n_ranges>,<flags>,<rx_cdbm>,<fp_cdbm>,<gw_ms>,
	  onde t_ms é o uptime da tag no POLL da rodada e gw_ms o uptime do
	  gateway na recepção. Lida por tools/rtls_log.py. O printk é síncrono
	  (~6 ms por linha a 115200 bps) e o rádio não escuta enquanto imprime:
	  desligue com muitas tags.

config RTLS_GATEWAY_STATS_PERIOD_S
	int "Período do resumo de recepção por tag (s; 0 desliga)"
	default 10

config RTLS_GATEWAY_SIM_TAGS
	int "Tags simuladas no snapshot para o host (teste do M6)"
	default 0
	range 0 32
	help
	  Acrescenta N registros sintéticos (IDs 0x1F00 + i, posição andando
	  em x e round avançando a cada snapshot) aos das tags reais. Serve
	  para testar a paginação e o CRC do SPI com mais de 9 tags (T6.3,
	  T6.4) sem montar a bancada. Deixe 0 em uso normal.

endmenu

source "Kconfig.zephyr"
