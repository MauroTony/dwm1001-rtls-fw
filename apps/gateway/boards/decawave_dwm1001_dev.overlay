/*
 * Gateway: SPI1 do header RPi vira SPI escravo (SPIS) para o host, e P0.26
 * sinaliza dado pronto (DRDY). Mesmos pinos do SPI/IRQ do PANS.
 * Protocolo: docs/05-interface-spi-gateway.md.
 */

/ {
	chosen {
		rtls,host-spi = &spi1;
	};

	zephyr,user {
		drdy-gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	spis1_default: spis1_default {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 0, 4)>,
				<NRF_PSEL(SPIS_MOSI, 0, 6)>,
				<NRF_PSEL(SPIS_MISO, 0, 7)>,
				<NRF_PSEL(SPIS_CSN, 0, 3)>;
		};
	};

	spis1_sleep: spis1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 0, 4)>,
				<NRF_PSEL(SPIS_MOSI, 0, 6)>,
				<NRF_PSEL(SPIS_MISO, 0, 7)>,
				<NRF_PSEL(SPIS_CSN, 0, 3)>;
			low-power-enable;
		};
	};
};

&spi1 {
	compatible = "nordic,nrf-spis";
	status = "okay";
	/* 0x00 = "ainda não pronto" para o host enquanto os buffers não estão armados. */
	def-char = <0x00>;
	pinctrl-0 = <&spis1_default>;
	pinctrl-1 = <&spis1_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ cs-gpios;
};

/* Barramento do DW1000 (já habilitado na placa; explícito por segurança). */
&spi2 {
	status = "okay";
};
