mainmenu "RTLS - Tag"

menu "Tag"

config RTLS_NODE_ID
	hex "Endereço curto da tag"
	default 0x1001
	range 0x1001 0x1FFF

config RTLS_TAG_UPDATE_RATE_HZ
	int "Taxa de atualização da posição (Hz)"
	default 10
	range 1 50

config RTLS_TAG_ANCHOR_BASE_ID
	hex "Endereço da primeira âncora consultada"
	default 0xA001
	range 0xA001 0xAFFF

config RTLS_TAG_NUM_ANCHORS
	int "Quantidade de âncoras (IDs consecutivos a partir da base)"
	default 4
	range 1 4

config RTLS_TAG_TDMA
	bool "Transmite só no slot do superquadro TDMA (M7)"
	help
	  A tag espera o BEACON do gateway (CONFIG_RTLS_GATEWAY_BEACON=y) e
	  faz a rodada no slot k = RTLS_NODE_ID - 0x1001 do superquadro. Sem
	  BEACON por 3 superquadros seguidos, para de transmitir até
	  sincronizar de novo. O período vem do BEACON, e
	  RTLS_TAG_UPDATE_RATE_HZ é ignorado. Desligado, a tag roda no próprio
	  ciclo, como nas bancadas do M2 ao M6, que não usam gateway.

config RTLS_TAG_CSV_OUTPUT
	bool "Imprime cada distância e cada posição em CSV na UART"
	default y
	help
	  Uma linha por distância: R,<round>,<t_ms>,<ancora>,<dist_mm>,
	  <rx_power_cdbm>,<fp_power_cdbm>,<raw_mm>, onde dist_mm é a distância
	  final (corrigida por RSL, se habilitado) e raw_mm é o DS-TWR antes da
	  correção. Uma linha por posição do EKF: L,<round>,<t_ms>,<x_mm>,
	  <y_mm>,<z_mm>,<sx_mm>,<sy_mm>,<sz_mm>,<n_ranges>,<flags>. Lidas por
	  tools/rtls_log.py.

config RTLS_TAG_STATS_PERIOD_S
	int "Período do resumo de estatísticas do TWR (s; 0 desliga)"
	default 10

endmenu

source "Kconfig.zephyr"
