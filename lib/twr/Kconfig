config RTLS_TWR_MATH
	bool "Matemática do DS-TWR (sem dependência de hardware)"
	help
	  Intervalos com wrap de 40 bits e estimador DS-TWR assimétrico
	  (docs/04-algoritmos.md, seção 2).

menuconfig RTLS_TWR
	bool "Motor DS-TWR (initiator na tag, responder na âncora)"
	depends on RTLS_DW1000
	select RTLS_TWR_MATH
	select RTLS_PROTO

if RTLS_TWR

config RTLS_TWR_REPLY_DELAY_US
	int "Atraso de resposta T_reply (µs)"
	default 1000
	range 300 5000
	help
	  Intervalo entre receber um quadro e transmitir a resposta no
	  primeiro slot. Folgado no início para absorver a latência
	  IRQ -> thread -> SPI; reduzir após medir (M3).

config RTLS_TWR_SLOT_US
	int "Espaçamento entre slots de resposta T_slot (µs)"
	default 1000
	range 500 5000
	help
	  A tag para de esperar RESPs no meio do slot do FINAL. Meio slot
	  precisa cobrir o tempo no ar (~0,2 ms) mais a programação do FINAL.

config RTLS_TWR_RX_MARGIN_US
	int "Margem extra das janelas de RX (µs)"
	default 500
	range 0 5000

config RTLS_TWR_RANGE_BIAS_CORRECTION
	bool "Corrige o viés de distância dependente do nível de sinal (APS011)"
	default y
	help
	  Estima o RSL pela equação de Friis a partir da distância medida
	  (LOS, canal 5) e subtrai a correção interpolada da tabela 2 do
	  APS011 para PRF de 64 MHz. A tabela supõe a calibração de antena
	  feita onde o viés é zero (-77 dBm): 5,0 m com ganho total de 0 dB.

config RTLS_TWR_RANGE_BIAS_GAIN_DB_X10
	int "Ganho das antenas menos perdas, para o cálculo do RSL (dB x 10)"
	default 0
	range -200 200
	depends on RTLS_TWR_RANGE_BIAS_CORRECTION
	help
	  Soma dos ganhos das antenas de TX e RX menos as perdas de PCB, em
	  décimos de dB. 0 trata as antenas como isotrópicas sem perdas
	  (aproximação: o ganho da antena da DWM1001 não foi caracterizado).
	  Se mudar este valor, a distância de calibração passa a ser
	  5,0 m x 10^(G/20).

module = RTLS_TWR
module-str = rtls_twr
source "subsys/logging/Kconfig.template.log_config"

endif # RTLS_TWR
